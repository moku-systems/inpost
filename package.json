{
  "name": "@moku-systems/inpost",
  "version": "0.1.0",
  "description":  "Unofficial TypeScript SDK for InPost API (developers.inpost-group.com)",
  "keywords": [
    "inpost",
    "shipping",
    "courier",
    "parcel",
    "paczkomat",
    "logistics",
    "api",
    "sdk",
    "typescript",
    "unofficial"
  ],
  "author": {
    "name": "Moku Systems",
    "email":  "hello@moku-systems.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/moku-systems/inpost.git"
  },
  "bugs": {
    "url": "https://github.com/moku-systems/inpost/issues"
  },
  "homepage": "https://github.com/moku-systems/inpost#readme",
  
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import":  "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./types": {
      "require": "./dist/cjs/types/index.js",
      "import": "./dist/esm/types/index.js",
      "types": "./dist/types/types/index.d.ts"
    }
  },
  
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  
  "scripts": {
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build:esm":  "tsc --project tsconfig. esm.json",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist/types",
    "clean":  "rimraf dist coverage",
    "dev": "tsc --watch",
    
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    
    "lint": "eslint src --ext . ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check":  "prettier --check \"src/**/*. ts\"",
    
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test",
    
    "prepublishOnly": "npm run validate && npm run build",
    "prepare": "husky install"
  },
  
  "dependencies": {
    "axios": "^1.6.5"
  },
  
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node":  "^20.11.5",
    
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    
    "prettier": "^3.2.4",
    
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    
    "typescript": "^5.3.3",
    
    "rimraf": "^5.0.5",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0"
  },
  
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}